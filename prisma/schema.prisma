generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  LGA_CHAIRMAN
  PROPERTY_OWNER
}

enum UserStatus {
  ACTIVE
  INVITED
}

enum LgaStatus {
  ACTIVE
  ONBOARDING
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         UserRole
  status       UserStatus @default(INVITED)
  lgaId        String?
  lga          Lga?       @relation("LgaMembers", fields: [lgaId], references: [id], onDelete: SetNull)
  chairedLgas  Lga[]      @relation("LgaChairman")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([lgaId])
  @@map("users")
}

model Lga {
  id         String    @id @default(cuid())
  code         String    @unique
  name         String
  state        String
  status       LgaStatus @default(ONBOARDING)
  chairmanName String?
  chairmanId   String?
  chairman   User?     @relation("LgaChairman", fields: [chairmanId], references: [id], onDelete: SetNull)
  members    User[]    @relation("LgaMembers")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([state, name])
  @@unique([chairmanId])
  @@map("lgas")
}
